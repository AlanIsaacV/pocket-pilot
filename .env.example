POSTGRES_USER=pocket_pilot
POSTGRES_PASSWORD=pocket_pilot_dev
POSTGRES_DB=pocket_pilot
DATABASE_URL=postgres://pocket_pilot:pocket_pilot_dev@localhost:5432/pocket_pilot?sslmode=disable
GRPC_PORT=50051

# Market price cron (investments Fase 4). All disabled by default.
# MARKETPRICE_ENABLED=true registers the scheduler; the first tick lands at
# 22:00 UTC unless MARKETPRICE_RUN_ON_BOOT forces one at server start.
# MARKETPRICE_PROVIDER picks the upstream source; only "yahoo" is implemented.
# MARKETPRICE_ADMIN_TOKEN gates the admin RPC used for manual kicks.
MARKETPRICE_ENABLED=false
MARKETPRICE_RUN_ON_BOOT=false
MARKETPRICE_PROVIDER=yahoo
MARKETPRICE_ADMIN_TOKEN=
