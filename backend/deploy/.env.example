# ── Raspberry Pi stack environment ───────────────────────────────────
# Copy to .env and fill in. The real .env is NOT versioned.

# ── Postgres: a database and role OWNED by this project, on the shared Postgres ──
# Create the database + role once (with the infra stack up):
#   docker compose -f /opt/stacks/infra/compose.yaml exec postgres \
#     psql -U "$POSTGRES_USER" \
#       -c "CREATE USER pocket_pilot WITH PASSWORD 'set-a-strong-one';" \
#       -c "CREATE DATABASE pocket_pilot OWNER pocket_pilot;"
# compose.yaml builds DATABASE_URL from these three.
DB_USER=pocket_pilot
DB_PASSWORD=
DB_NAME=pocket_pilot

# ── Required by the server (it refuses to start without these) ──
# Google Gemini API key used by the AI assistant + notification parser.
GEMINI_API_KEY=
# Secret for signing/verifying the app's own JWTs. Use a long random string.
JWT_SECRET=

# ── OAuth sign-in (leave blank to disable a provider) ──
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── AI quotas (optional; defaults shown) ──
# AI_DAILY_REQUEST_LIMIT=50
# AI_MONTHLY_TOKEN_LIMIT=500000
# NOTIFICATION_PARSER_DAILY_LIMIT=50
# NOTIFICATION_PARSER_MONTHLY_TOKEN_LIMIT=200000
# AI_CHAT_MODEL=gemini-3.1-flash-lite-preview
# NOTIFICATION_PARSER_MODEL=gemini-3.1-flash-lite-preview

# ── Market price cron (investments; all disabled by default) ──
# MARKETPRICE_ENABLED registers the daily scheduler (first tick 22:00 UTC).
# MARKETPRICE_RUN_ON_BOOT forces one run at startup.
# MARKETPRICE_PROVIDER picks the upstream source; only "yahoo" is implemented.
# MARKETPRICE_ADMIN_TOKEN gates the admin RPC used for manual kicks.
MARKETPRICE_ENABLED=false
MARKETPRICE_RUN_ON_BOOT=false
MARKETPRICE_PROVIDER=yahoo
MARKETPRICE_ADMIN_TOKEN=
