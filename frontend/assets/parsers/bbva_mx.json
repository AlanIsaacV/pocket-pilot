{
  "schema_version": 1,
  "bank_id": "bbva_mx",
  "display_name": "BBVA México",
  "package_names": [
    "com.bbva.bancomermovil",
    "com.bancomer.mbanking"
  ],
  "version": 2,
  "default_currency": "MXN",
  "ignore_patterns": [
    {
      "field": "title",
      "regex": "(?i)(promoci[oó]n|aviso|publicidad|recordatorio|oferta)"
    },
    {
      "field": "text",
      "regex": "(?i)(token|c[oó]digo de seguridad|c[oó]digo din[aá]mico|sms din[aá]mico|verificaci[oó]n)"
    }
  ],
  "patterns": [
    {
      "id": "purchase_tdc",
      "transaction_type": "expense",
      "match": {
        "field": "text",
        "regex": "^COMPRA TDC EN (?<merchant>.+?) \\$(?<amount>[\\d,]+\\.\\d{2})\\s+\\d+\\s+\\w+\\s+\\d{1,2}:\\d{2}h\\s*$",
        "flags": "s"
      },
      "captures": {
        "amount_cents": {"from": "amount", "transform": "money_to_cents"},
        "currency_code": {"from": "currency", "transform": "upper", "default": "MXN"},
        "merchant_description": {"from": "merchant", "transform": "trim"}
      }
    },
    {
      "id": "account_charge",
      "transaction_type": "expense",
      "match": {
        "field": "text",
        "regex": "^Cargo a tu cuenta \\*\\d{0,2}(?<digits>\\d{4}) de \\$(?<amount>[\\d,]+\\.\\d{2})\\s*$",
        "flags": "s"
      },
      "captures": {
        "amount_cents": {"from": "amount", "transform": "money_to_cents"},
        "currency_code": {"from": "currency", "transform": "upper", "default": "MXN"},
        "card_last_digits": {"from": "digits"}
      }
    },
    {
      "id": "card_payment_credit",
      "transaction_type": "income",
      "match": {
        "field": "text",
        "regex": "^Abono a tu tarjeta \\*\\d{0,2}(?<digits>\\d{4}) de \\$(?<amount>[\\d,]+\\.\\d{2})\\s*$",
        "flags": "s"
      },
      "captures": {
        "amount_cents": {"from": "amount", "transform": "money_to_cents"},
        "currency_code": {"from": "currency", "transform": "upper", "default": "MXN"},
        "card_last_digits": {"from": "digits"}
      }
    },
    {
      "id": "account_credit",
      "transaction_type": "income",
      "match": {
        "field": "text",
        "regex": "^Abono a tu cuenta \\*\\d{0,2}(?<digits>\\d{4}) de \\$(?<amount>[\\d,]+\\.\\d{2})\\s*$",
        "flags": "s"
      },
      "captures": {
        "amount_cents": {"from": "amount", "transform": "money_to_cents"},
        "currency_code": {"from": "currency", "transform": "upper", "default": "MXN"},
        "card_last_digits": {"from": "digits"}
      }
    }
  ]
}
